extends SceneTree
const Classes = preload("res://scripts/class_progress.gd")
const Model = preload("res://scripts/survival_model.gd")
var failed := false
func require(condition: bool, message: String) -> void:
    if not condition:
        push_error(message)
        failed=true
func _initialize() -> void:
    var configuration: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://resources/survival_demo.json")).configuration
    var fresh=Classes.migrate({})
    require(Classes.unlocked(fresh,"warrior") and not Classes.unlocked(fresh,"rogue") and not Classes.unlocked(fresh,"sorcerer"),"Only Warrior starts unlocked")
    var progress=Classes.record({}, {"kills":499,"outcome":"dead"})
    progress=Classes.record(progress,{"kills":1,"outcome":"dead"})
    require(Classes.unlocked(progress,"rogue") and not Classes.unlocked(progress,"sorcerer"),"Cumulative kills must unlock Rogue")
    progress=Classes.record(progress,{"kills":0,"outcome":"victory"})
    require(Classes.unlocked(progress,"sorcerer"),"Victory must unlock Sorcerer")
    for i in range(60):progress=Classes.record(progress,{"kills":1,"outcome":"dead"})
    require(progress.runs.size()==50 and progress.total_kills==560 and Classes.unlocked(progress,"sorcerer"),"History trimming must preserve unlocks")
    progress=Classes.migrate(JSON.parse_string(JSON.stringify(progress)))
    require(progress.total_kills==560,"Reload must not double count kills")
    for key in ["rogue","sorcerer"]:
        var ranged=Model.new(Classes.configure(configuration,key))
        ranged.spawn_at(ranged.player+Vector2(200,0),1)
        ranged.automatic_attack()
        require(ranged.kills==0 and ranged.projectiles.size()==1,"Ranged classes must launch projectiles")
        for i in range(30):ranged.tick(0.02,Vector2.ZERO)
        require(ranged.kills==1,"Projectile collision must damage distant enemies")
    var wallet=Classes.migrate({"gold":0})
    require(Classes.purchase(wallet,"vitality").is_empty(),"Unaffordable purchase must be refused")
    wallet=Classes.record(wallet,{"kills":20,"seconds":300,"outcome":"victory"})
    require(wallet.gold==100 and wallet.runs.back().gold_earned==100,"Gold must reward kills, time and victory")
    wallet=Classes.purchase(wallet,"vitality")
    require(wallet.gold==50 and wallet.shop.vitality==1,"Purchase must charge once and add rank")
    require(Classes.price(wallet,"vitality")==100,"Shop prices must scale")
    var upgraded=Classes.configure(configuration,"rogue",wallet)
    require(upgraded.player.health==85,"Permanent bonus must apply after class base stats")
    wallet=Classes.migrate(JSON.parse_string(JSON.stringify(wallet)))
    require(wallet.gold==50 and wallet.shop.vitality==1,"Gold and purchase must survive reload")
    wallet.gold=99999
    require(Classes.purchase(wallet,"archery").is_empty(),"Locked class bonuses must not be purchasable")
    wallet=Classes.purchase(wallet,"cleave")
    require(Classes.configure(configuration,"warrior",wallet).player.attack_targets==4,"Warrior bonus must add cleave target")
    require(Classes.configure(configuration,"rogue",wallet).player.attack_targets==1,"Warrior bonus must not affect Rogue")
    wallet=Classes.purchase(wallet,"armor")
    require(Classes.configure(configuration,"warrior",wallet).player.armor==1,"Defense purchase must add armor")
    wallet.shop.vitality=10;wallet.gold=99999
    require(Classes.purchase(wallet,"vitality").is_empty(),"Rank cap must block purchases")
    var model = Model.new(configuration)
    var same = Model.new(configuration)
    model.spawn_directed();same.spawn_directed()
    require(model.enemies[0].position == same.enemies[0].position,"Seed must reproduce spawning")
    model.enemies.clear()
    model.spawn_at(model.player+Vector2(35,0),1)
    model.automatic_attack()
    require(model.kills==1 and model.corpses.size()==1 and model.pickups.size()>=1,"Combat must produce death and XP")
    model.enemies.clear();model.pickups.clear()
    model.xp=5;model.check_level_up()
    require(model.state=="upgrade" and model.offered.size()==3,"Level must offer three upgrades")
    var elapsed: float=model.elapsed
    model.tick(1,Vector2.RIGHT)
    require(model.elapsed==elapsed,"Upgrade must freeze gameplay")
    require(model.choose_upgrade(0) and model.state=="playing","Upgrade must resume play")
    model.stats.summon_cap=1;model.tick(0.01,Vector2.ZERO)
    require(model.allies.size()==1 and model.allies[0].owner=="player","Summon must belong to player")
    model.allies[0].age=60;model.tick(0.01,Vector2.ZERO)
    require(model.allies.is_empty(),"Summon lifetime must expire")
    model.config.director.max_enemies=1;model.enemies.clear()
    model.spawn_at(model.player,999);model.spawn_at(model.player,999)
    require(model.enemies.size()==1,"Director must honor enemy cap")
    model.attack_clock=999;model.health=1;model.invulnerability=0
    model.tick(0.01,Vector2.ZERO)
    require(model.state=="dead" and model.health==0,"Contact damage must end run")
    var winner=Model.new(configuration)
    winner.base_stats.max_health=100000;winner.stats.max_health=100000;winner.health=100000;winner.config.duration_seconds=480
    for i in range(10000):
        if winner.state=="upgrade":winner.choose_upgrade(0)
        winner.tick(0.05,Vector2.RIGHT.rotated(i*0.01))
    require(winner.state=="victory","Full eight-minute simulation must reach victory")
    if not failed:print("GAMESHIFT_SURVIVAL_RULES_OK")
    quit(1 if failed else 0)
