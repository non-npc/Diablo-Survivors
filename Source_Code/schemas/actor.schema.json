{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "actor",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "speed": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "visual": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "display_name",
    "speed",
    "visual",
    "provenance"
  ]
}
