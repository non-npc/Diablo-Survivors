{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ability",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "melee",
        "projectile",
        "pulse",
        "orbital",
        "beam",
        "trap",
        "chain",
        "aura",
        "damage_over_time"
      ]
    },
    "cooldown": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "damage": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "cooldown",
    "damage"
  ]
}
