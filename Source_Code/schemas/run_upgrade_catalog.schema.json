{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "stat",
      "step",
      "mode",
      "description",
      "icon",
      "max_tier"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "stat": {
        "enum": [
          "ally_cooldown",
          "ally_damage",
          "area_scale",
          "armor",
          "attack_count",
          "attack_range",
          "attack_targets",
          "cooldown",
          "crit_chance",
          "crit_multiplier",
          "damage",
          "dot_damage",
          "heal_drop_chance",
          "kill_heal",
          "knockback",
          "max_health",
          "pickup_radius",
          "projectile_speed",
          "regeneration",
          "retaliation",
          "speed",
          "splash_ratio",
          "summon_cap",
          "xp_multiplier",
          "boost_duration",
          "projectile_count",
          "projectile_pierce"
        ]
      },
      "step": {
        "type": "number",
        "minimum": 0
      },
      "mode": {
        "enum": [
          "add",
          "multiply",
          "reduce"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "icon": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50
      },
      "max_tier": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "classes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "warrior",
            "rogue",
            "sorcerer"
          ]
        }
      },
      "requires": {
        "type": "string"
      },
      "heal": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
